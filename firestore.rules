rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Hilfsfunktion: Prüft, ob der Nutzer angemeldet ist und in der Whitelist steht
    function isWhitelisted() {
      // 1. Prüfen, ob der Nutzer überhaupt angemeldet ist (auth != null) und eine E-Mail besitzt
      // 2. Prüfen, ob ein Dokument mit seiner normalisierten E-Mail in der "whitelist" Kollektion existiert
      return request.auth != null && 
             request.auth.token.email != null &&
             exists(/databases/$(database)/documents/whitelist/$(request.auth.token.email.lower()));
    }

    match /whitelist/{email} {
      allow read: if request.auth != null && 
                     request.auth.token.email != null && 
                     (request.auth.token.email == email || request.auth.token.email.lower() == email);
    }

    match /users/{userId}/{document=**} {
      allow read, write: if isWhitelisted() && request.auth.uid == userId;
    }
  }
}
