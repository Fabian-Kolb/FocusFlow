rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // -------------------------------------------------------------
    // Helper-Funktionen für Authentifizierung & Whitelist
    // -------------------------------------------------------------
    function isAuthenticated() {
      return request.auth != null && request.auth.uid != null;
    }

    function isWhitelisted() {
      return isAuthenticated() &&
             request.auth.token.email != null &&
             request.auth.token.email_verified == true &&
             exists(/databases/$(database)/documents/whitelist/$(request.auth.token.email.lower()));
    }

    function isOwner(userId) {
      return isWhitelisted() && request.auth.uid == userId;
    }

    // -------------------------------------------------------------
    // 1. Whitelist-Kollektion
    // Nur Lesezugriff für den eigenen Whitelist-Eintrag; Schreibzugriff strikt verboten
    // -------------------------------------------------------------
    match /whitelist/{email} {
      allow read: if isAuthenticated() &&
                     request.auth.token.email != null &&
                     request.auth.token.email.lower() == email.lower();
      allow write: if false;
    }

    // -------------------------------------------------------------
    // 2. Dedizierte Server-Tokens (OAuth Refresh-Tokens)
    // Client-Zugriff zu 100% verboten - nur Firebase Admin SDK hat Zugriff!
    // -------------------------------------------------------------
    match /server_tokens/{userId} {
      allow read, write: if false;
    }

    // -------------------------------------------------------------
    // 2b. KI-Kontingent für Gäste (Zähler pro Tag)
    // Client-Zugriff verboten - nur der Server zählt (Service Account).
    // Anonyme Gast-Konten haben ohnehin keinen Zugriff: alle Datenregeln verlangen
    // verifizierte E-Mail plus Whitelist.
    // -------------------------------------------------------------
    match /guest_ai_usage/{docId} {
      allow read, write: if false;
    }

    // -------------------------------------------------------------
    // 3. Benutzer-Kollektionen (/users/{userId}/...)
    // Explizite Subcollection-Regeln OHNE rekursive Wildcards!
    // -------------------------------------------------------------
    match /users/{userId} {
      // Kein Zugriff auf das Root-User-Dokument selbst:
      allow read, write: if false;

      // Legacy-Token-Pfad: Strikt gesperrt für alle Clients
      match /tokens/{document=**} {
        allow read, write: if false;
      }

      // A) Projekte
      match /projects/{projectId} {
        allow read: if isOwner(userId);
        allow delete: if isOwner(userId);

        allow create: if isOwner(userId) &&
          projectId == request.resource.data.id &&
          request.resource.data.keys().hasAll(['id', 'title']) &&
          request.resource.data.keys().hasOnly([
            'id', 'title', 'description', 'category', 'categoryId', 'sortOrder', 'phases', 'status', 'progress',
            'isPaused', 'inKanban', 'nextStep', 'startDate', 'endDate', 'dateRange', 'daysRemaining',
            'timeElapsed', 'phasesCompleted', 'phasesTotal', 'tasksCompleted', 'tasksTotal',
            'warning', 'notes', 'history', 'createdAt', 'updatedAt', 'deletedAt', '_type', 'tags', 'order',
            'tasksCountText', 'daysCountText', 'recommendedSteps', 'isPinned', 'firstPhase', 'lastUpdated',
            'environmentId', 'type', 'exam', 'hints'
          ]) &&
          (!('environmentId' in request.resource.data) || request.resource.data.environmentId in ['hochschule', 'arbeit', 'gym']) &&
          (!('type' in request.resource.data) || request.resource.data.type == 'fach') &&
          (!('exam' in request.resource.data) || (request.resource.data.exam is map && request.resource.data.exam.size() <= 2)) &&
          (!('hints' in request.resource.data) || (request.resource.data.hints is list && request.resource.data.hints.size() <= 200)) &&
          request.resource.data.title is string &&
          request.resource.data.title.size() > 0 &&
          request.resource.data.title.size() <= 200 &&
          (!('progress' in request.resource.data) || (request.resource.data.progress is number && request.resource.data.progress >= 0 && request.resource.data.progress <= 100)) &&
          (!('phases' in request.resource.data) || (request.resource.data.phases is list && request.resource.data.phases.size() <= 50)) &&
          (!('notes' in request.resource.data) || (request.resource.data.notes is list && request.resource.data.notes.size() <= 100)) &&
          request.resource.data.keys().size() <= 50;

        allow update: if isOwner(userId) &&
          request.resource.data.id == resource.data.id &&
          request.resource.data.keys().hasAll(['id', 'title']) &&
          request.resource.data.keys().hasOnly([
            'id', 'title', 'description', 'category', 'categoryId', 'sortOrder', 'phases', 'status', 'progress',
            'isPaused', 'inKanban', 'nextStep', 'startDate', 'endDate', 'dateRange', 'daysRemaining',
            'timeElapsed', 'phasesCompleted', 'phasesTotal', 'tasksCompleted', 'tasksTotal',
            'warning', 'notes', 'history', 'createdAt', 'updatedAt', 'deletedAt', '_type', 'tags', 'order',
            'tasksCountText', 'daysCountText', 'recommendedSteps', 'isPinned', 'firstPhase', 'lastUpdated',
            'environmentId', 'type', 'exam', 'hints'
          ]) &&
          (!('environmentId' in request.resource.data) || request.resource.data.environmentId in ['hochschule', 'arbeit', 'gym']) &&
          (!('type' in request.resource.data) || request.resource.data.type == 'fach') &&
          (!('exam' in request.resource.data) || (request.resource.data.exam is map && request.resource.data.exam.size() <= 2)) &&
          (!('hints' in request.resource.data) || (request.resource.data.hints is list && request.resource.data.hints.size() <= 200)) &&
          request.resource.data.title is string &&
          request.resource.data.title.size() > 0 &&
          request.resource.data.title.size() <= 200 &&
          (!('progress' in request.resource.data) || (request.resource.data.progress is number && request.resource.data.progress >= 0 && request.resource.data.progress <= 100)) &&
          (!('phases' in request.resource.data) || (request.resource.data.phases is list && request.resource.data.phases.size() <= 50)) &&
          (!('notes' in request.resource.data) || (request.resource.data.notes is list && request.resource.data.notes.size() <= 100)) &&
          request.resource.data.keys().size() <= 50;
      }

      // B) Erinnerungen / Tasks
      match /reminders/{reminderId} {
        allow read: if isOwner(userId);
        allow delete: if isOwner(userId);

        allow create: if isOwner(userId) &&
          reminderId == request.resource.data.id &&
          request.resource.data.keys().hasAll(['id', 'title']) &&
          request.resource.data.keys().hasOnly([
            'id', 'title', 'description', 'date', 'time', 'category', 'categoryId', 'sortOrder', 'priority',
            'status', 'isPaused', 'inKanban', 'completed', 'notes', 'history', 'createdAt',
            'updatedAt', 'deletedAt', '_type', 'tags', 'dateRange', 'daysRemaining', 'timeElapsed', 'order',
            'isPinned', 'startDate', 'endDate', 'lastUpdated', 'isCalendarSynced', 'googleEventId',
            'recurrence', 'lastCompletedAt', 'kind', 'quick', 'parked', 'waitingFor', 'environmentId'
          ]) &&
          (!('environmentId' in request.resource.data) || request.resource.data.environmentId in ['hochschule', 'arbeit', 'gym']) &&
          (!('recurrence' in request.resource.data) || request.resource.data.recurrence == null || (request.resource.data.recurrence is map && request.resource.data.recurrence.size() <= 5)) &&
          (!('lastCompletedAt' in request.resource.data) || request.resource.data.lastCompletedAt is number) &&
          (!('kind' in request.resource.data) || request.resource.data.kind in ['abgabe', 'pruefung']) &&
          (!('quick' in request.resource.data) || request.resource.data.quick is bool) &&
          (!('parked' in request.resource.data) || request.resource.data.parked is bool) &&
          (!('waitingFor' in request.resource.data) || (request.resource.data.waitingFor is string && request.resource.data.waitingFor.size() <= 80)) &&
          request.resource.data.title is string &&
          request.resource.data.title.size() > 0 &&
          request.resource.data.title.size() <= 300 &&
          (!('completed' in request.resource.data) || request.resource.data.completed is bool) &&
          (!('isCalendarSynced' in request.resource.data) || request.resource.data.isCalendarSynced is bool) &&
          (!('googleEventId' in request.resource.data) || request.resource.data.googleEventId == null || request.resource.data.googleEventId is string) &&
          (!('notes' in request.resource.data) || (request.resource.data.notes is list && request.resource.data.notes.size() <= 50)) &&
          request.resource.data.keys().size() <= 50;

        allow update: if isOwner(userId) &&
          request.resource.data.id == resource.data.id &&
          request.resource.data.keys().hasAll(['id', 'title']) &&
          request.resource.data.keys().hasOnly([
            'id', 'title', 'description', 'date', 'time', 'category', 'categoryId', 'sortOrder', 'priority',
            'status', 'isPaused', 'inKanban', 'completed', 'notes', 'history', 'createdAt',
            'updatedAt', 'deletedAt', '_type', 'tags', 'dateRange', 'daysRemaining', 'timeElapsed', 'order',
            'isPinned', 'startDate', 'endDate', 'lastUpdated', 'isCalendarSynced', 'googleEventId',
            'recurrence', 'lastCompletedAt', 'kind', 'quick', 'parked', 'waitingFor', 'environmentId'
          ]) &&
          (!('environmentId' in request.resource.data) || request.resource.data.environmentId in ['hochschule', 'arbeit', 'gym']) &&
          (!('recurrence' in request.resource.data) || request.resource.data.recurrence == null || (request.resource.data.recurrence is map && request.resource.data.recurrence.size() <= 5)) &&
          (!('lastCompletedAt' in request.resource.data) || request.resource.data.lastCompletedAt is number) &&
          (!('kind' in request.resource.data) || request.resource.data.kind in ['abgabe', 'pruefung']) &&
          (!('quick' in request.resource.data) || request.resource.data.quick is bool) &&
          (!('parked' in request.resource.data) || request.resource.data.parked is bool) &&
          (!('waitingFor' in request.resource.data) || (request.resource.data.waitingFor is string && request.resource.data.waitingFor.size() <= 80)) &&
          request.resource.data.title is string &&
          request.resource.data.title.size() > 0 &&
          request.resource.data.title.size() <= 300 &&
          (!('completed' in request.resource.data) || request.resource.data.completed is bool) &&
          (!('isCalendarSynced' in request.resource.data) || request.resource.data.isCalendarSynced is bool) &&
          (!('googleEventId' in request.resource.data) || request.resource.data.googleEventId == null || request.resource.data.googleEventId is string) &&
          (!('notes' in request.resource.data) || (request.resource.data.notes is list && request.resource.data.notes.size() <= 50)) &&
          request.resource.data.keys().size() <= 50;
      }

      // C) Inbox Items
      match /inboxItems/{itemId} {
        allow read: if isOwner(userId);
        allow delete: if isOwner(userId);

        allow create: if isOwner(userId) &&
          itemId == request.resource.data.id &&
          request.resource.data.keys().hasAll(['id', 'title']) &&
          request.resource.data.keys().hasOnly([
            'id', 'title', 'summary', 'originalText', 'category',
            'createdAt', 'updatedAt', 'deletedAt', '_type',
            'cleanText', 'extractedDateType', 'extractedDate', 'extractedEndDate', 'extractedTime',
            'type', 'completed', 'tags', 'environmentId'
          ]) &&
          (!('environmentId' in request.resource.data) || request.resource.data.environmentId in ['hochschule', 'arbeit', 'gym']) &&
          request.resource.data.title is string &&
          request.resource.data.title.size() > 0 &&
          request.resource.data.title.size() <= 500 &&
          (!('summary' in request.resource.data) || (request.resource.data.summary is string && request.resource.data.summary.size() <= 10000)) &&
          (!('originalText' in request.resource.data) || (request.resource.data.originalText is string && request.resource.data.originalText.size() <= 50000)) &&
          request.resource.data.keys().size() <= 30;

        allow update: if isOwner(userId) &&
          request.resource.data.id == resource.data.id &&
          request.resource.data.keys().hasAll(['id', 'title']) &&
          request.resource.data.keys().hasOnly([
            'id', 'title', 'summary', 'originalText', 'category',
            'createdAt', 'updatedAt', 'deletedAt', '_type',
            'cleanText', 'extractedDateType', 'extractedDate', 'extractedEndDate', 'extractedTime',
            'type', 'completed', 'tags', 'environmentId'
          ]) &&
          (!('environmentId' in request.resource.data) || request.resource.data.environmentId in ['hochschule', 'arbeit', 'gym']) &&
          request.resource.data.title is string &&
          request.resource.data.title.size() > 0 &&
          request.resource.data.title.size() <= 500 &&
          (!('summary' in request.resource.data) || (request.resource.data.summary is string && request.resource.data.summary.size() <= 10000)) &&
          (!('originalText' in request.resource.data) || (request.resource.data.originalText is string && request.resource.data.originalText.size() <= 50000)) &&
          request.resource.data.keys().size() <= 30;
      }

      // D) Projekt-Kategorien
      match /categories/{categoryId} {
        allow read: if isOwner(userId);
        allow delete: if isOwner(userId);

        allow create, update: if isOwner(userId) &&
          categoryId == request.resource.data.id &&
          request.resource.data.keys().hasAll(['id', 'name']) &&
          request.resource.data.keys().hasOnly(['id', 'name', 'order', 'isExpanded', 'createdAt', 'updatedAt']) &&
          request.resource.data.name is string &&
          request.resource.data.name.size() > 0 &&
          request.resource.data.name.size() <= 100 &&
          (!('order' in request.resource.data) || request.resource.data.order is number) &&
          (!('isExpanded' in request.resource.data) || request.resource.data.isExpanded is bool) &&
          request.resource.data.keys().size() <= 10;
      }

      // E) Reminder-Kategorien
      match /reminderCategories/{categoryId} {
        allow read: if isOwner(userId);
        allow delete: if isOwner(userId);

        allow create, update: if isOwner(userId) &&
          categoryId == request.resource.data.id &&
          request.resource.data.keys().hasAll(['id', 'name']) &&
          request.resource.data.keys().hasOnly(['id', 'name', 'order', 'isExpanded', 'createdAt', 'updatedAt']) &&
          request.resource.data.name is string &&
          request.resource.data.name.size() > 0 &&
          request.resource.data.name.size() <= 100 &&
          (!('order' in request.resource.data) || request.resource.data.order is number) &&
          (!('isExpanded' in request.resource.data) || request.resource.data.isExpanded is bool) &&
          request.resource.data.keys().size() <= 10;
      }

      // F) Chat Data
      match /chat_data/{docId} {
        allow read: if isOwner(userId);
        allow delete: if isOwner(userId);

        allow create, update: if isOwner(userId) &&
          docId == 'sessions' &&
          request.resource.data.keys().hasOnly(['sessions', 'activeSessionId', 'lastUpdated']) &&
          (!('sessions' in request.resource.data) || (request.resource.data.sessions is list && request.resource.data.sessions.size() <= 100)) &&
          request.resource.data.keys().size() <= 5;
      }

      // G) Kanban Views (Gespeicherte Ansichten & Filter)
      match /kanbanViews/{viewId} {
        allow read: if isOwner(userId);
        allow delete: if isOwner(userId);

        allow create, update: if isOwner(userId) &&
          viewId == request.resource.data.id &&
          request.resource.data.keys().hasAll(['id', 'name']) &&
          request.resource.data.keys().hasOnly([
            'id', 'name', 'icon', 'color', 'type', 'isSystem',
            'showProjects', 'showReminders', 'projectCategoryIds', 'reminderCategoryIds',
            'order', 'createdAt', 'updatedAt'
          ]) &&
          request.resource.data.name is string &&
          request.resource.data.name.size() > 0 &&
          request.resource.data.name.size() <= 100 &&
          (!('type' in request.resource.data) || request.resource.data.type in ['system', 'custom']) &&
          (!('isSystem' in request.resource.data) || request.resource.data.isSystem is bool) &&
          (!('showProjects' in request.resource.data) || request.resource.data.showProjects is bool) &&
          (!('showReminders' in request.resource.data) || request.resource.data.showReminders is bool) &&
          (!('projectCategoryIds' in request.resource.data) || (request.resource.data.projectCategoryIds is list && request.resource.data.projectCategoryIds.size() <= 50)) &&
          (!('reminderCategoryIds' in request.resource.data) || (request.resource.data.reminderCategoryIds is list && request.resource.data.reminderCategoryIds.size() <= 50)) &&
          (!('order' in request.resource.data) || request.resource.data.order is number) &&
          request.resource.data.keys().size() <= 15;
      }

      // H) Gym: Übungen, Trainingstage (Pläne), Trainings und Körperwerte
      match /gymExercises/{exerciseId} {
        allow read: if isOwner(userId);
        allow delete: if isOwner(userId);

        allow create, update: if isOwner(userId) &&
          exerciseId == request.resource.data.id &&
          request.resource.data.keys().hasAll(['id', 'name']) &&
          request.resource.data.keys().hasOnly(['id', 'name', 'createdAt', 'updatedAt']) &&
          request.resource.data.name is string &&
          request.resource.data.name.size() > 0 &&
          request.resource.data.name.size() <= 100 &&
          request.resource.data.keys().size() <= 6;
      }

      match /gymPlans/{planId} {
        allow read: if isOwner(userId);
        allow delete: if isOwner(userId);

        allow create, update: if isOwner(userId) &&
          planId == request.resource.data.id &&
          request.resource.data.keys().hasAll(['id', 'name']) &&
          request.resource.data.keys().hasOnly(['id', 'name', 'exerciseIds', 'order', 'createdAt', 'updatedAt']) &&
          request.resource.data.name is string &&
          request.resource.data.name.size() > 0 &&
          request.resource.data.name.size() <= 100 &&
          (!('exerciseIds' in request.resource.data) || (request.resource.data.exerciseIds is list && request.resource.data.exerciseIds.size() <= 40)) &&
          (!('order' in request.resource.data) || request.resource.data.order is number) &&
          request.resource.data.keys().size() <= 10;
      }

      match /gymWorkouts/{workoutId} {
        allow read: if isOwner(userId);
        allow delete: if isOwner(userId);

        allow create, update: if isOwner(userId) &&
          workoutId == request.resource.data.id &&
          request.resource.data.keys().hasAll(['id', 'date']) &&
          request.resource.data.keys().hasOnly(['id', 'date', 'planId', 'startedAt', 'endedAt', 'exerciseIds', 'sets', 'note', 'createdAt', 'updatedAt']) &&
          request.resource.data.date is string &&
          request.resource.data.date.size() == 10 &&
          (!('planId' in request.resource.data) || request.resource.data.planId is string) &&
          (!('startedAt' in request.resource.data) || request.resource.data.startedAt is number) &&
          (!('endedAt' in request.resource.data) || request.resource.data.endedAt is number) &&
          (!('exerciseIds' in request.resource.data) || (request.resource.data.exerciseIds is list && request.resource.data.exerciseIds.size() <= 40)) &&
          (!('sets' in request.resource.data) || (request.resource.data.sets is list && request.resource.data.sets.size() <= 300)) &&
          (!('note' in request.resource.data) || (request.resource.data.note is string && request.resource.data.note.size() <= 1000)) &&
          request.resource.data.keys().size() <= 13;
      }

      match /gymBody/{entryId} {
        allow read: if isOwner(userId);
        allow delete: if isOwner(userId);

        allow create, update: if isOwner(userId) &&
          entryId == request.resource.data.id &&
          request.resource.data.keys().hasAll(['id', 'date', 'weight']) &&
          request.resource.data.keys().hasOnly(['id', 'date', 'weight', 'note', 'createdAt', 'updatedAt']) &&
          request.resource.data.date is string &&
          request.resource.data.date.size() == 10 &&
          request.resource.data.weight is number &&
          request.resource.data.weight > 0 &&
          request.resource.data.weight < 1000 &&
          (!('note' in request.resource.data) || (request.resource.data.note is string && request.resource.data.note.size() <= 500)) &&
          request.resource.data.keys().size() <= 8;
      }
    }
  }
}
